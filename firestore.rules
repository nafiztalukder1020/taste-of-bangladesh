rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each visitor's food journey: everyone can read, only the owner can write
    match /journeys/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code','name','d','f','fav','ch','s','top','cards','t','v'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 28
        && request.resource.data.code is string && request.resource.data.code.size() == 6
        && request.resource.data.d is int && request.resource.data.d >= 0 && request.resource.data.d <= 64
        && request.resource.data.f is int && request.resource.data.f >= 0 && request.resource.data.f <= 200;
    }
    // "N people have used this map" counter: can only go up by one
    match /meta/stats {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.n == 1;
      allow update: if request.auth != null && request.resource.data.n == resource.data.n + 1;
    }
  }
}
